  IR --> ART
  ART --> CDPP
  CDPP --> AGS25
  TIR --> NDO
  ART --> NDO
  BAN --> EXP
  ART --> STAY
  STAY --> SEV
  SEV --> S70
  AGS25 --> SEV
  PORT --> FED
  SEV --> FED
